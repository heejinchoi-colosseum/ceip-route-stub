# env.sh.example — 복사해 env.sh 로 두고 값을 채운다. env.sh 는 gitignore 대상이다.

# Shopify 앱(dev-ceip-app) 자격증명
export SHOPIFY_API_KEY=<client-id>
export SHOPIFY_API_SECRET=<client-secret>

# Shopify application_url (App URL 호스트, ngrok). 콜백 모듈의 /connect 화면도 이 값으로 start 폼 주소를 만든다.
export APP_HOST=https://<your-ngrok-domain>.ngrok-free.dev

# Shopify 콜백(redirect_uri) 호스트. App URL 과 다른 호스트로 두어 검증한다 (cloudflared).
# cloudflared quick tunnel 은 재시작마다 주소가 바뀌므로, 바뀌면 이 값과 Shopify Redirect URL 을 다시 맞춘다.
# 미설정 시 APP_HOST 로 폴백해 start·callback 이 같은 호스트를 쓴다(기존 동작).
export CALLBACK_HOST=https://<your-cloudflared-host>.trycloudflare.com

# 선택: 서비스별 콜백 호스트. start 가 service 로 switch 해 redirect_uri 호스트를 다르게 만든다.
# 각 호스트의 /oauth/shopify/default/callback 을 Shopify Allowed redirection URL(s) 에 모두 등록한다.
# cloudflared quick tunnel 을 하나 더 띄우면(같은 8081 을 가리켜도 된다) 두 번째 호스트가 생긴다. 미설정 시 CALLBACK_HOST.
# export CALLBACK_HOST_CGS=https://<second-cloudflared-host>.trycloudflare.com
# export CALLBACK_HOST_COLO1=
# export CALLBACK_HOST_COLO_NOVA=

# 선택: 콜백이 app/uninstalled 웹훅 구독을 만들 때 쓰는 GraphQL Admin API 버전. 미설정 시 2026-07.
# export SHOPIFY_API_VERSION=2026-07

# 선택: 개인정보 웹훅 3종(customers/data_request, customers/redact, shop/redact)의 접수 담당 service. 미설정 시 cgs.
# 이 세 topic 은 앱 설정에 주소가 하나뿐이라 service 쿼리를 실을 수 없어 릴레이가 이 값으로 전달처를 고른다.
# export COMPLIANCE_SERVICE=cgs

# Cafe24 앱 자격증명. Redirect URI(s) 에는 $APP_HOST/oauth/cafe24/default/callback 하나만 등록한다.
# 라우터(8080)가 그 콜백을 받아 CALLBACK_HOST(cgs, 8081), CALLBACK_HOST_COLO1(colo1.0, 8082)로 넘긴다.
export CAFE24_CLIENT_ID=<client-id>
export CAFE24_CLIENT_SECRET=<client-secret>
# /cafe24/connect 화면이 보낼 테스트 쇼핑몰 ID(https://{mall_id}.cafe24api.com)
export CAFE24_MALL_ID=<mall-id>
# 개발자센터 WebHook "인증정보". Cafe24 웹훅에는 서명이 없고 이 값이 X-API-Key 헤더로 온다(라우터 8080 이 비교).
export CAFE24_WEBHOOK_KEY=<webhook-key>
# 선택: 요청 scope(콤마 구분). 앱 권한 설정에 등록한 것만 요청할 수 있다.
# export CAFE24_SCOPES=mall.read_order,mall.read_product,mall.read_store
